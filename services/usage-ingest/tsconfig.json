{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ESNext"],
    "types": ["@cloudflare/workers-types", "./worker-configuration.d.ts", "node"],
    "paths": {
      "@kilocode/web-shared/*": ["../../packages/web-shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts", "vitest.config.ts"]
}
